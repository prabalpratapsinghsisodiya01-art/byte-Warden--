generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  vault     Vault[]
}

model Vault {
  id        String   @id @default(uuid())
  title     String
  username  String?
  password  String   // In a real app, this should be symmetrically encrypted with the user's master password before sending to the backend!
  url       String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
